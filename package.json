{
  "name": "blink-wire",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "description": "Heads-up Telegram, Slack & Discord triage with 1-tap AI replies and G2 voice capture for Even Realities G2",
  "scripts": {
    "dev": "vite",
    "relay": "node server/standalone.ts",
    "build": "tsc --noEmit && tsc -p tsconfig.server.json --noEmit && vite build",
    "preview": "vite preview",
    "pack": "npm run build && evenhub pack app.json dist --sdk-ver 0.0.10",
    "simulate": "evenhub-simulator http://localhost:5173"
  },
  "dependencies": {
    "@evenrealities/even_hub_sdk": "^0.0.10"
  },
  "devDependencies": {
    "@evenrealities/evenhub-cli": "^0.1.12",
    "@evenrealities/evenhub-simulator": "^0.7.2",
    "@types/node": "^22.10.0",
    "typescript": "^5.7.0",
    "vite": "^5.4.0"
  }
}
