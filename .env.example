# Required for live Telegram read/write (get a token in 30s from @BotFather)
TELEGRAM_BOT_TOKEN=

# Optional: Slack channel triage (Bot User OAuth Token + Channel ID)
SLACK_BOT_TOKEN=
SLACK_CHANNEL_ID=

# Optional: Discord channel triage (Bot Token + Channel ID)
DISCORD_BOT_TOKEN=
DISCORD_CHANNEL_ID=

# Optional: AI quick-reply drafting (OpenRouter or OpenAI)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4o-mini
OPENAI_API_KEY=

# Optional: Speech-to-Text for G2 voice replies & incoming Telegram voice-note transcription
GROQ_API_KEY=

# Standalone relay host/port (defaults to 127.0.0.1 for security)
RELAY_HOST=127.0.0.1
RELAY_PORT=8781
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
