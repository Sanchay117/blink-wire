# Required for live Telegram read/write (get a token in 30s from @BotFather)
TELEGRAM_BOT_TOKEN=

# Optional: Slack channel triage (Bot User OAuth Token + Channel ID)
SLACK_BOT_TOKEN=
SLACK_CHANNEL_ID=

# Optional: Discord channel triage (Bot Token + Channel ID)
DISCORD_BOT_TOKEN=
DISCORD_CHANNEL_ID=

# Optional: AI quick-reply drafting (OpenRouter or OpenAI)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4o-mini
OPENAI_API_KEY=

# Optional: Speech-to-Text for G2 voice replies (Groq Whisper or OpenAI Whisper)
GROQ_API_KEY=

# Standalone relay port (for phone/physical G2 sideloading)
RELAY_PORT=8781
